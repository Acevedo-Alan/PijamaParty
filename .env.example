# Copy to .env and fill in real values. Never commit .env.

# Spring profile: dev | prod
SPRING_PROFILES_ACTIVE=dev

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pijamaparty
# PostgreSQL superuser of the local container (deploy/docker-compose.dev.yml); never used by the application
DB_ADMIN_PASSWORD=
# Application role (no owner, no BYPASSRLS) - see RNF-27
# TEMPORARY until T-E0-13 creates tienda_app: local dev uses DB_APP_USER=postgres and DB_APP_PASSWORD=<DB_ADMIN_PASSWORD>
DB_APP_USER=
DB_APP_PASSWORD=
# Migration role used by Flyway (table owner)
DB_OWNER_USER=
DB_OWNER_PASSWORD=

# OAuth2 (CU-27)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
