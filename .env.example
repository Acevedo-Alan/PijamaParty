# Copy to .env and fill in real values. Never commit .env.

# Spring profile: dev | prod (there is no default profile)
SPRING_PROFILES_ACTIVE=dev

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pijamaparty
# Superuser of the PostgreSQL container: only for the first start (deploy/db/init); never used by the application
DB_ADMIN_PASSWORD=
# Roles created by deploy/db/init/01-roles.sh (RNF-27, RNF-29.2)
# Application: no owner, no superuser, no BYPASSRLS, only SELECT/INSERT/UPDATE/DELETE
DB_APP_USER=tienda_app
DB_APP_PASSWORD=
# Flyway migrations: owns the tables
DB_OWNER_USER=tienda_owner
DB_OWNER_PASSWORD=
# pg_dump backups: read-only
DB_BACKUP_USER=tienda_backup
DB_BACKUP_PASSWORD=

# Production only: regex of the Caddy address allowed to set X-Forwarded-For (RNF-22), e.g. 172\.30\.0\.10.
# deploy/docker-compose.yml sets it already, and there the passwords come from deploy/secrets/, not from this file.
TRUSTED_PROXY_REGEX=

# Production stack (deploy/docker-compose.yml): the public domain Caddy gets certificates for, and optional host
# ports (default 80 and 443; e.g. DOMAIN=localhost, HTTP_PORT=8088, HTTPS_PORT=8443 to try it locally)
DOMAIN=
HTTP_PORT=
HTTPS_PORT=

# First back office administrator (UC-04): created at startup only when none exists, then ignored. In production the
# password is the Docker secret deploy/secrets/ADMIN_INITIAL_PASSWORD (12 characters to 72 bytes).
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_INITIAL_PASSWORD=
# T-E1-16: key of the authenticator secret (base64 of 32 bytes; a Docker secret in production, the dev profile has a
# default) and the one-time reset of the second factor after losing the phone and the recovery codes.
SECOND_FACTOR_KEY=
ADMIN_RESET_SECOND_FACTOR=false

# Product photos (CU-06): the directory they are written to (default /srv/uploads, the volume of the API image) and
# where the libvips command line (vips, vipsheader) is when it is not on the PATH, e.g. C:\vips\bin on Windows.
# UPLOADS_DIR=
VIPS_BIN_DIR=

# MercadoPago Checkout Pro (T-E3-06): the seller's access token (test credentials give the sandbox; a Docker secret
# in production) and the storefront's origin MercadoPago sends the buyer back to (default http://localhost:5173;
# production uses https://DOMAIN). Without a token every checkout is unavailable and the order waits on its tracking
# page.
MERCADOPAGO_ACCESS_TOKEN=
# PUBLIC_URL=
# MercadoPago Webhooks (T-E3-07): the secret key of the application's Webhooks, in "Tus integraciones" (a Docker
# secret in production). Without it every payment notification is refused with 401 and orders are never paid.
MERCADOPAGO_WEBHOOK_SECRET=

# MODO payment button (T-E3b-02): off unless MODO_ENABLED=true. The credentials (Docker secrets in production) and the
# processor code come in the email MODO sends after the sign-up; for development use MODO's generic preproduction
# credentials with the preproduction URLs below. Without credentials or processor code every MODO checkout is
# unavailable; in production, enabled without them the API does not start.
MODO_ENABLED=false
MODO_USERNAME=
MODO_PASSWORD=
MODO_PROCESSOR_CODE=
# MODO_BASE_URL=https://merchants.preprod.playdigital.com.ar
# MODO_CHECKOUT_URL=https://site.preprod.modo.com.ar

# Payment-confirmed emails (T-E3-09), sent through Resend: its API key (a Docker secret in production), the sender
# (e.g. Pijama Party <pedidos@notificaciones.DOMAIN>, a domain verified at Resend), the business's email the buyer's
# answers go to (optional) and the administrator told of every paid order. Production requires all but the reply-to.
# Without a key or a sender every email waits in the outbox, retried until it fails after 5 attempts.
RESEND_API_KEY=
# Resend's bounce and complaint webhook (T-E3-22): its signing secret, whsec_... (a Docker secret in production).
# Without it every notification is refused with 401 and bounced emails show no alert in the back office.
RESEND_WEBHOOK_SECRET=
MAIL_FROM=
MAIL_REPLY_TO=
NOTIFICATIONS_ADMIN_EMAIL=

# Sign-in with Google and Facebook (UC-27, T-E4-14): each provider is off while its client id is empty, and its
# button is not shown. The client secrets are Docker secrets in production (deploy/secrets). The redirect URIs to
# register are PUBLIC_URL + /api/account/oauth2/code/google and .../facebook (in dev, http://localhost:5173/...).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Analytics (RNF-25), read when the frontend is built: GA4 measurement id (G-...) and Meta Pixel id (digits). Leave
# empty to build without analytics and without the consent banner.
VITE_GA4_MEASUREMENT_ID=
VITE_META_PIXEL_ID=
