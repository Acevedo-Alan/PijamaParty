{
	# Caddy logs upstream failures with the whole request. Keep only what helps to debug: no full client IP, no
	# headers (cookies, tokens), no query string, which may carry tokens or personal data (R-05, RNF-22), and no
	# tracking token of the order paths /api/orders/{token} and /pedido/{token} (T-E3-08, RNF-29.6).
	log default {
		format filter {
			wrap json
			fields {
				request>remote_ip ip_mask 24 48
				request>client_ip ip_mask 24 48
				request>headers delete
				request>uri regexp (\?).*$|(/api/orders/|/pedido/)[^/?]+ ${1}${2}REDACTED
			}
		}
	}
}

# RNF-29.9: HSTS and the content security policy live here, not in the application. The CSP allows this origin and
# the analytics domains of RNF-25 (loaded only after consent, T-E1-23). MercadoPago, MODO, Google and Facebook need
# no entry: the storefront reaches them by top-level navigation, which CSP does not restrict, and loads no script,
# frame or form of theirs (T-E6-03). Tested against this image by e2e/lighthouse/headers.spec.ts.
(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		Content-Security-Policy "default-src 'self'; script-src 'self' https://www.googletagmanager.com https://connect.facebook.net; style-src 'self'; img-src 'self' data: https://*.google-analytics.com https://*.googletagmanager.com https://www.facebook.com; font-src 'self'; connect-src 'self' https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com https://www.facebook.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}
}

# The backend, for the API and the link previews.
(api) {
	reverse_proxy api:8080 {
		# RNF-22: overwrite, never append, so the backend sees the real client IP and nothing a client forged.
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
		# Other client-IP headers are dropped so nothing downstream can trust a forged one.
		header_up -X-Real-IP
		header_up -Forwarded
		transport http {
			# RNF-21: a refused or silently dropped connection (full Tomcat queue) fails fast instead of hanging.
			dial_timeout 3s
			response_header_timeout 30s
		}
	}
}

# One domain (E0 plan): the frontend build at /, the API at /api/*, uploaded images at /uploads/*. No CORS, and
# cookies stay first-party. HTTPS certificates are automatic for {$DOMAIN}.
{$DOMAIN} {
	encode zstd gzip
	import security_headers

	handle /api/* {
		import api
	}

	# Uploaded images are stored as WebP only (RNF-29.4); nothing else is served from this same-origin path. Every
	# upload gets a new server-generated file name and a file never changes, so browsers keep it a year (T-E6-02).
	handle /uploads/* {
		@notWebp not path *.webp
		respond @notWebp 404
		root * /srv
		@photo file
		header @photo Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# T-E6-07 (RNF-31.2): WhatsApp, Facebook, Instagram, X and Telegram build a shared product's preview without running
	# JavaScript, so only their bots get the API's preview page of /producto/{slug}. Instagram's previews come from
	# facebookexternalhit; the in-app browsers of Instagram and Facebook (Instagram, FBAN, FBAV) get the store as usual.
	# Tested against this image by e2e/lighthouse/previews.spec.ts.
	@linkPreview {
		path_regexp linkPreview ^/producto/([a-z0-9]+(?:-[a-z0-9]+)*)/?$
		header_regexp User-Agent (?i)(facebookexternalhit|facebookcatalog|whatsapp|twitterbot|telegrambot)
	}
	header /producto/* Vary User-Agent
	handle @linkPreview {
		rewrite * /api/catalog/products/{re.linkPreview.1}/preview
		import api
	}

	# T-E6-23 (RNF-31.1): search engines skip the back office, the account, checkout, tracking links, search results
	# and the API (the storefront adds noindex to the same paths, frontend/src/features/seo/privatePaths.ts), and
	# read the sitemap the API writes from the catalog. Tested against this image by e2e/lighthouse/seo.spec.ts.
	handle /robots.txt {
		header Content-Type "text/plain; charset=utf-8"
		respond <<TXT
			User-agent: *
			Disallow: /admin
			Disallow: /cuenta
			Disallow: /checkout
			Disallow: /pedido
			Disallow: /buscar
			Disallow: /api/

			Sitemap: https://{$DOMAIN}/sitemap.xml
			TXT 200
	}
	handle /sitemap.xml {
		rewrite * /api/catalog/sitemap
		import api
	}

	# The single-page app: unknown paths fall back to index.html, where the router shows its own 404 (RNF-31.7).
	# Hashed build files are kept a year; index.html is checked on every visit, so a deploy shows at once (T-E6-02).
	handle {
		root * /srv/www
		try_files {path} /index.html
		file_server
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@notAssets not path /assets/*
		header @notAssets Cache-Control "no-cache"
	}

	# RNF-21: when the backend cannot take the request, answer like the API does: 503 + Retry-After in problem+json.
	handle_errors 502 503 504 {
		import security_headers
		@api path /api/*
		handle @api {
			header Content-Type "application/problem+json"
			header Retry-After "5"
			respond `{"type":"about:blank","title":"Service Unavailable","status":503}` 503
		}
	}
}
